{
  "name": "voting-dapp-backend",
  "version": "1.0.0",
  "description": "Express/TypeScript backend enhancement for voting-dapp-pyteal-react",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/src/server.js",
    "dev": "nodemon dist/src/server.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "algosdk": "^2.7.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
